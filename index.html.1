  else { MW_TABLE[idx][field] = value===''? null : Number(value); }
}
function addMwRow(){ MW_TABLE.push({state:'New State', unskilled:null, semiskilled:null, skilled:null, highlyskilled:null}); renderMwEditor(); }
function deleteMwRow(idx){ MW_TABLE.splice(idx,1); renderMwEditor(); }
async function saveMwTable(){

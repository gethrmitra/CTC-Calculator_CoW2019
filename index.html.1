    <div class="modal-sub">${escapeHtml(c.designation||'–')} · ${escapeHtml(c.department||'–')} ${c.grade?'· Grade '+escapeHtml(c.grade):''} ${c.doj?'· DOJ '+c.doj:''}</div>
    <table class="calc"><thead><tr><th>Component</th><th>Monthly</th><th>Annual</th></tr></thead><tbody>
      <tr class="section"><td colspan="3">${escapeHtml(inp.state)} · ${CAT_LABEL[inp.category]} · ${inp.metro==='Y'?'Metro':'Non-Metro'} · PF: ${inp.pf==='Y'?'Yes':'No'}</td></tr>
      <tr class="section"><td colspan="3">Earnings</td></tr>
      <tr><td>Basic</td><td class="mono">${fmt(calc.basic)}</td><td class="mono">${fmt(calc.basic*12)}</td></tr>
      ${rowsHtml(byCat('earnings'))}
      <tr class="section"><td colspan="3">Excluded Allowance</td></tr>
      ${rowsHtml(byCat('excluded_allowance'))}
      <tr class="section"><td colspan="3">Reimbursements</td></tr>
      ${rowsHtml(byCat('reimbursement'))}
      <tr><td>Employer PF</td><td class="mono">${fmt(calc.employerPF)}</td><td class="mono">${fmt(calc.employerPF*12)}</td></tr>
      <tr class="total"><td>Total Remuneration (R)</td><td class="mono">${fmt(calc.R)}</td><td class="mono">${fmt(calc.R*12)}</td></tr>
      <tr><td>Employer ESI</td><td class="mono">${fmt(calc.employerESI)}</td><td class="mono">${fmt(calc.employerESI*12)}</td></tr>
      <tr><td>Gratuity</td><td class="mono">${fmt(calc.gratuity)}</td><td class="mono">${fmt(calc.gratuity*12)}</td></tr>
      ${benefitsHtml}
      <tr class="grand"><td>CTC</td><td class="mono">${fmt(calc.ctc)}</td><td class="mono">${fmt(calc.ctc*12)}</td></tr>
      <tr><td>Incentive / PLB</td><td class="mono">${fmt(calc.incentive)}</td><td class="mono">${fmt(calc.incentive*12)}</td></tr>
      <tr class="grand"><td>CTC incl. Incentive</td><td class="mono">${fmt(calc.ctc+calc.incentive)}</td><td class="mono">${fmt((calc.ctc+calc.incentive)*12)}</td></tr>
      <tr><td>Employee PF</td><td class="mono">${fmt(calc.employeePF)}</td><td class="mono">${fmt(calc.employeePF*12)}</td></tr>
      <tr><td>Employee ESI</td><td class="mono">${fmt(calc.employeeESI)}</td><td class="mono">${fmt(calc.employeeESI*12)}</td></tr>
      <tr class="grand"><td>Cash in Hand (CIH)</td><td class="mono">${fmt(calc.cih)}</td><td class="mono">${fmt(calc.cih*12)}</td></tr>
    </tbody></table>`;
  document.getElementById('modalBg').classList.add('show');
}
function closeModal(){ document.getElementById('modalBg').classList.remove('show'); }

function exportCsv(){
  if(!CANDIDATES.length){ alert('No candidates to export.'); return; }
  const headers = ['Name','Department','Designation','Grade','DOJ','State','Category','Metro','PF Applicable',
    'Remuneration (mo)','Basic','Employer PF','Statutory Bonus','Employer ESI','Gratuity','Total Benefits',
    'CTC (monthly)','CTC (annual)','Incentive','Employee PF','Employee ESI','Cash in Hand (monthly)','Cash in Hand (annual)','Saved On'];
  const lines = [headers.join(',')];
  CANDIDATES.forEach(c=>{
    const i=c.inputs, k=c.calc;
    const row = [c.name,c.department,c.designation,c.grade,c.doj,i.state,CAT_LABEL[i.category],
      i.metro==='Y'?'Metro':'Non-Metro', i.pf==='Y'?'Yes':'No', k.R, k.basic, k.employerPF, k.bonus,
      k.employerESI, k.gratuity, k.totalBenefits, k.ctc, k.ctc*12, k.incentive, k.employeePF, k.employeeESI,
      k.cih, k.cih*12, new Date(c.savedAt).toLocaleDateString('en-IN')]
      .map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',');
    lines.push(row);
  });
  const blob = new Blob([lines.join('\n')], {type:'text/csv'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href=url; a.download='candidate-database.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
}

/* ============================================================
   AUTHENTICATION (client-side access gate — see note to user:
   this keeps casual users out of admin settings but is not
   cryptographically secure, since anyone can view page source)
   ============================================================ */
let AUTH_CONFIG = { adminPassword: 'admin123', userPassword: 'user123' };
let currentRole = null; // 'admin' | 'user'
let loginRoleChoice = 'user';

function setLoginRole(role){
  loginRoleChoice = role;
  document.getElementById('roleBtnUser').classList.toggle('active', role==='user');
  document.getElementById('roleBtnAdmin').classList.toggle('active', role==='admin');
  document.getElementById('loginError').textContent = '';
}
async function loadAuthConfig(){
  const val = await SharedStore.get('auth');
  if(val){ AUTH_CONFIG = Object.assign(AUTH_CONFIG, val); }
}
async function saveAuthConfig(){
  const adminPw = document.getElementById('adminPasswordInput').value.trim();
  const userPw = document.getElementById('userPasswordInput').value.trim();
  if(!adminPw || !userPw){ alert('Both access codes must be non-empty.'); return; }
  const updated = { adminPassword: adminPw, userPassword: userPw };
  const ok = await SharedStore.set('auth', updated);
  if(ok){ AUTH_CONFIG = updated; alert('Access codes updated for every login.'); }
  else { alert('Could not reach the shared database — access codes were not updated. Check your connection and try again.'); }
}
function renderAdminAccessCard(){
  const el = document.getElementById('adminAccessFields');
  if(!el) return;
  el.innerHTML = `
    <div class="row2">
      <div><label>Admin Access Code</label><input type="text" id="adminPasswordInput" value="${escapeHtml(AUTH_CONFIG.adminPassword)}"></div>
      <div><label>User Access Code</label><input type="text" id="userPasswordInput" value="${escapeHtml(AUTH_CONFIG.userPassword)}"></div>
    </div>
    <button class="btn small" style="margin-top:10px;" onclick="saveAuthConfig()">Update Access Codes</button>
    <div class="hint" style="margin-top:8px;">These codes gate access to this tool. They are stored in this browser's/account's storage, not encrypted — treat this as a basic access gate for trusted colleagues, not as protection for highly sensitive data.</div>`;
}
function attemptLogin(){
  const pw = document.getElementById('loginPassword').value;
  const errEl = document.getElementById('loginError');
  const expected = loginRoleChoice==='admin' ? AUTH_CONFIG.adminPassword : AUTH_CONFIG.userPassword;
  if(pw === expected || (loginRoleChoice==='user' && pw === AUTH_CONFIG.adminPassword)){
    // an admin code also unlocks user-level access; admin role only granted when admin code entered under Admin toggle
    currentRole = (loginRoleChoice==='admin' && pw===AUTH_CONFIG.adminPassword) ? 'admin' : 'user';
    try{ sessionStorage.setItem('sst-role', currentRole); }catch(e){}
    enterApp();
  } else {
    errEl.textContent = 'Incorrect access code for the selected role.';
  }
}
function logout(){
  currentRole = null;
  try{ sessionStorage.removeItem('sst-role'); }catch(e){}
  document.getElementById('appRoot').style.display = 'none';
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('loginPassword').value = '';
  document.getElementById('loginError').textContent = '';
}
function enterApp(){
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('appRoot').style.display = 'block';
  const badge = document.getElementById('roleBadge');
  badge.textContent = currentRole==='admin' ? 'Admin' : 'User';
  document.getElementById('tabBtnMw').style.display = currentRole==='admin' ? '' : 'none';
  document.getElementById('tabBtnComp').style.display = currentRole==='admin' ? '' : 'none';
  showPage('calc');
}

/* ============================================================
   TABS, STORAGE NOTICE & INIT
   ============================================================ */
function showPage(name){
  if((name==='mw' || name==='comp') && currentRole!=='admin') name = 'calc';
  ['calc','mw','comp','db'].forEach(p=>document.getElementById('page-'+p).classList.toggle('active', p===name));
  document.getElementById('tabBtnCalc').classList.toggle('active', name==='calc');
  document.getElementById('tabBtnMw').classList.toggle('active', name==='mw');
  document.getElementById('tabBtnComp').classList.toggle('active', name==='comp');
  document.getElementById('tabBtnDb').classList.toggle('active', name==='db');
  if(name==='mw') renderMwEditor();
  if(name==='comp'){ renderComponentConfig(); renderAdminAccessCard(); }
}
function showStorageNotice(){
  const note = document.querySelector('footer.note');
  if(Store.mode === 'local'){
    note.innerHTML = 'Minimum Wages, Formulas and login access codes are shared with every login. Your Candidate Database is saved only in this browser, on this device.';
  } else if(Store.mode === 'memory'){
    note.innerHTML = '⚠ This browser does not support local storage — your Candidate Database will be lost when you close this tab. Use Export CSV to keep a copy. Minimum Wages and Formulas are still shared normally.';
  } else {
    note.innerHTML = 'Minimum Wages, Formulas and login access codes are shared with every login. Your Candidate Database is personal to your account.';
  }
}
async function init(){
  populateStates(); runCalc(); showStorageNotice();

  // pull the three shared records from Supabase; fall back to built-in
  // defaults (already in memory) if the network call fails for any reason
  const [authVal, mwVal, cfgVal] = await Promise.all([
    SharedStore.get('auth'),
    SharedStore.get('mw_table'),
    SharedStore.get('formulas')
  ]);
  if(authVal) AUTH_CONFIG = Object.assign(AUTH_CONFIG, authVal);
  if(mwVal && Array.isArray(mwVal) && mwVal.length) MW_TABLE = mwVal;
  if(cfgVal && Object.keys(cfgVal).length) CONFIG = Object.assign(defaultConfig(), cfgVal);

  populateStates(); runCalc(); loadCandidates();

  const submitBtn = document.getElementById('loginSubmitBtn');
  submitBtn.disabled = false;
  submitBtn.textContent = 'Sign In';
  if(!authVal && !mwVal && !cfgVal){
    document.getElementById('loginError').textContent = 'Could not reach the shared database — showing default data. Check your internet connection.';
  }

  try{
    const savedRole = sessionStorage.getItem('sst-role');
    if(savedRole==='admin' || savedRole==='user'){ currentRole = savedRole; }
  }catch(e){}
  if(currentRole){ enterApp(); }
}
init();
</script>
</body>
</html>

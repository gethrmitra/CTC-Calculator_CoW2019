}
function renderBanner(inputs, c){
  const el = document.getElementById('mwBanner');
  const mwText = c.MW ? "₹"+c.MW.toLocaleString('en-IN')+" / month" : "not published for this state/category";
  let cls = 'ok';
  let msg = `<b>${CAT_LABEL[inputs.category]}</b> minimum wage in <b>${escapeHtml(inputs.state)}</b>: <b>${mwText}</b>.`;
  if(c.warnings.length){
    cls = c.warnings.some(w=>w.includes('below the applicable'))? 'bad':'warn';
    msg += '<br>' + c.warnings.map(w=>'⚠ '+w).join('<br>');
  } else {
    msg += ' Remuneration comfortably clears the minimum wage floor.';
  }
  el.innerHTML = `<div class="banner ${cls}">${msg}</div>`;
}
function renderKpis(c){
  document.getElementById('kpiR').innerHTML = fmt(c.R) + " <small>/mo</small>";
  document.getElementById('kpiBasic').innerHTML = fmt(c.basic) + " <small>/mo</small>";
  document.getElementById('kpiCTC').innerHTML = fmt(c.ctc + (c.incentive||0)) + " <small>/mo</small>";
  document.getElementById('kpiCIH').innerHTML = fmt(c.cih) + " <small>/mo</small>";
}
function tag(cat){ return `<span class="cat-tag ${CATEGORY_TAGCLASS[cat]}">${CATEGORY_LABEL[cat]}</span>`; }

function renderBreakup(c){
  const rows = [];
  if(c.retainer){
    rows.push({label:'Retainer Fee', m:c.R, cls:'total'});
    rows.push({label:'Incentive / PLB', m:c.incentive});
    rows.push({label:'CTC', m:c.ctc, cls:'grand'});
    rows.push({label:'Cash in Hand (CIH)', m:c.cih, cls:'grand'});
  } else {
    const byCat = k => c.waterfall.lines.filter(l=>l.category===k);

    rows.push({label:'Earnings', m:null, cls:'section'});
    rows.push({label:'Basic', m:c.basic});
    byCat('earnings').forEach(l=>rows.push({label:l.name, m:l.amount}));

    rows.push({label:'Excluded Allowance', m:null, cls:'section'});
    byCat('excluded_allowance').forEach(l=>rows.push({label:l.name, m:l.amount}));

    rows.push({label:'Reimbursements', m:null, cls:'section'});
    byCat('reimbursement').forEach(l=>rows.push({label:l.name, m:l.amount}));

    rows.push({label:'Employer PF', m:c.employerPF, cls:'subitem'});
    rows.push({label:'Total Remuneration (R)', m:c.R, cls:'total'});

    rows.push({label:'Employer Contribution (added to CTC)', m:null, cls:'section'});
    rows.push({label:'Employer ESI', m:c.employerESI});
    rows.push({label:'Gratuity', m:c.gratuity});

    if(c.totalBenefits>0 || c.benefits.length){
      rows.push({label:'Benefits (added to CTC)', m:null, cls:'section'});
      c.benefits.forEach(b=>rows.push({label:b.name, m:b.amount}));
    }
    rows.push({label:'CTC (Remuneration + Employer ESI + Gratuity + Benefits)', m:c.ctc, cls:'total'});
    rows.push({label:'Incentive / PLB', m:c.incentive});
    rows.push({label:'CTC incl. Incentive', m:c.ctc+c.incentive, cls:'grand'});

    rows.push({label:'Employee Deductions', m:null, cls:'section'});
    rows.push({label:'Employee PF', m:c.employeePF});
    rows.push({label:'Employee ESI', m:c.employeeESI});
    rows.push({label:'Cash in Hand (Remuneration − Employer PF − Employee PF − Employee ESI)', m:c.cih, cls:'grand'});
  }
  document.getElementById('breakupBody').innerHTML = rows.map(row=>{
    if(row.m===null) return `<tr class="${row.cls||''}"><td colspan="3">${row.label}</td></tr>`;
    return `<tr class="${row.cls||''}"><td>${row.label}</td><td class="mono">${fmt(row.m)}</td><td class="mono">${fmt(row.m*12)}</td></tr>`;
  }).join('');
}

/* ============================================================
   CANDIDATE DATABASE
   ============================================================ */
let CANDIDATES = [];
async function loadCandidates(){
  try{
    const res = await Store.get('candidates-data');
    CANDIDATES = res && res.value ? JSON.parse(res.value) : [];
  }catch(e){ CANDIDATES = []; }
  renderDb();
}
async function persistCandidates(){
  try{ await Store.set('candidates-data', JSON.stringify(CANDIDATES)); }catch(e){ console.error('Storage error', e); }
}
async function saveCandidate(){
  const {inputs, c} = runCalc();
  const name = document.getElementById('inName').value.trim();
  if(!name){
    document.getElementById('saveMsg').textContent = 'Enter an employee name before saving.';
    document.getElementById('saveMsg').style.color = 'var(--red)';
    return;
  }
  const record = {
    id: newId('cand'), name,
    department: document.getElementById('inDept').value.trim(),
    designation: document.getElementById('inDesig').value.trim(),
    grade: document.getElementById('inGrade').value.trim(),
    doj: document.getElementById('inDoj').value,
    inputs, calc: c, savedAt: new Date().toISOString()
  };
  CANDIDATES.unshift(record);
  await persistCandidates();
  document.getElementById('saveMsg').textContent = `Saved "${name}" to the candidate database.`;
  document.getElementById('saveMsg').style.color = 'var(--teal)';
  renderDb();
}
async function deleteCandidate(id){ CANDIDATES = CANDIDATES.filter(c=>c.id!==id); await persistCandidates(); renderDb(); closeModal(); }
async function clearAll(){
  if(!CANDIDATES.length) return;
  if(!confirm('Remove all saved candidates? This cannot be undone.')) return;
  CANDIDATES = []; await persistCandidates(); renderDb();
}
function renderDb(){
  const wrap = document.getElementById('dbWrap');
  const q = document.getElementById('dbSearch').value.toLowerCase();
  const sort = document.getElementById('dbSort').value;
  let list = CANDIDATES.filter(c=>!q || [c.name,c.department,c.designation,c.inputs.state,c.grade].join(' ').toLowerCase().includes(q));
  if(sort==='new') list=[...list].sort((a,b)=>new Date(b.savedAt)-new Date(a.savedAt));
  if(sort==='old') list=[...list].sort((a,b)=>new Date(a.savedAt)-new Date(b.savedAt));
  if(sort==='name') list=[...list].sort((a,b)=>a.name.localeCompare(b.name));
  if(sort==='ctc') list=[...list].sort((a,b)=>(b.calc.ctc+(b.calc.incentive||0))-(a.calc.ctc+(a.calc.incentive||0)));

  if(!CANDIDATES.length){ wrap.innerHTML = `<div class="empty">No candidates saved yet.<br>Go to <b>Salary Calculator</b>, fill in the details, and click <b>Save to Candidate Database</b>.</div>`; return; }
  if(!list.length){ wrap.innerHTML = `<div class="empty">No candidates match "${escapeHtml(q)}".</div>`; return; }

  wrap.innerHTML = `<table class="db"><thead><tr>
      <th>Name</th><th>Designation / Dept.</th><th>State</th><th>Category</th>
      <th>Remuneration</th><th>CTC</th><th>Cash in Hand</th><th>PF</th><th>Saved</th><th></th>
    </tr></thead><tbody>
      ${list.map(c=>`<tr>
        <td><b>${escapeHtml(c.name)}</b>${c.grade?` <span style="color:#8592a0;">(${escapeHtml(c.grade)})</span>`:''}</td>
        <td>${escapeHtml(c.designation||'–')}${c.department?' · '+escapeHtml(c.department):''}</td>
        <td>${escapeHtml(c.inputs.state)}</td>
        <td>${CAT_LABEL[c.inputs.category]}</td>
        <td class="mono">${fmt(c.calc.R)}</td>
        <td class="mono">${fmt(c.calc.ctc+(c.calc.incentive||0))}</td>
        <td class="mono">${fmt(c.calc.cih)}</td>
        <td><span class="pill ${c.inputs.pf==='Y'?'y':'n'}">${c.inputs.pf==='Y'?'Yes':'No'}</span></td>
        <td>${new Date(c.savedAt).toLocaleDateString('en-IN')}</td>
        <td style="white-space:nowrap;">
          <button class="btn secondary small" onclick="viewCandidate('${c.id}')">View</button>
          <button class="btn danger small" onclick="deleteCandidate('${c.id}')">Delete</button>
        </td>
      </tr>`).join('')}
    </tbody></table>`;
}
function escapeHtml(s){ return (s||'').toString().replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }


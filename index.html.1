const Store = {
  mode: (typeof window.storage !== 'undefined') ? 'claude' : (typeof localStorage !== 'undefined' ? 'local' : 'memory'),
  _mem: {},
  async get(key){
    if(this.mode==='claude'){ try{ return await window.storage.get(key, false); }catch(e){ return null; } }
    if(this.mode==='local'){ try{ const v = localStorage.getItem('sst:'+key); return v!==null ? {value:v} : null; }catch(e){ return null; } }
    return (key in this._mem) ? {value:this._mem[key]} : null;
  },
  async set(key, value){
    if(this.mode==='claude'){ try{ return await window.storage.set(key, value, false); }catch(e){ return null; } }
    if(this.mode==='local'){ try{ localStorage.setItem('sst:'+key, value); return {value}; }catch(e){ return null; } }
    this._mem[key] = value; return {value};
  }
};


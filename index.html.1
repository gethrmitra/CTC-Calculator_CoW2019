function categorySelect(idx, current){
  return `<select onchange="earn(${idx},'category',this.value)">
    <option value="earnings" ${current==='earnings'?'selected':''}>Earnings</option>
    <option value="excluded_allowance" ${current==='excluded_allowance'?'selected':''}>Excluded Allowance</option>
    <option value="reimbursement" ${current==='reimbursement'?'selected':''}>Reimbursement</option>
  </select>`;
}
function renderEarnings(){
  const el = document.getElementById('earningsList');
  el.innerHTML = CONFIG.waterfall.map((c,idx)=>{
    const isPercent = c.type==='percent';
    const isFixed = c.type==='fixed';
    const isCappedRem = c.type==='remainderCapped';
    return `<div class="comp-card">
      <div class="comp-head">
        <span class="order-badge">${idx+1}</span>
        <input type="text" value="${escapeHtml(c.name)}" oninput="earn(${idx},'name',this.value)">
        ${categorySelect(idx, c.category)}
        <select onchange="earn(${idx},'type',this.value)">
          <option value="percent" ${isPercent?'selected':''}>Percentage (waterfall)</option>
          <option value="fixed" ${isFixed?'selected':''}>Fixed Amount</option>
          <option value="remainderCapped" ${isCappedRem?'selected':''}>Capped Remainder</option>
          <option value="remainder" ${c.type==='remainder'?'selected':''}>Full Remainder</option>
        </select>
        <div class="comp-actions">
          <button class="btn secondary small" title="Move up" onclick="moveEarning(${idx},-1)">↑</button>
          <button class="btn secondary small" title="Move down" onclick="moveEarning(${idx},1)">↓</button>
          <button class="btn danger small" onclick="removeEarning(${idx})">Delete</button>
        </div>
      </div>
      ${isPercent ? `
      <div class="comp-fields">
        <div><label>Base</label><select onchange="earn(${idx},'base',this.value)">
          <option value="wage" ${c.base==='wage'?'selected':''}>Remuneration</option>
          <option value="basic" ${c.base==='basic'?'selected':''}>Basic</option>
        </select></div>
        <div><label>Percent (%)</label><input type="number" step="0.01" value="${c.percent}" oninput="earn(${idx},'percent',this.value)"></div>
        <div><label>Non-Metro Override (%)</label><input type="number" step="0.5" value="${c.nonMetroPercent??''}" placeholder="same as above" oninput="earn(${idx},'nonMetroPercent',this.value)"></div>
        <div><label>Cap (₹)</label><input type="number" value="${c.cap??''}" placeholder="no cap" oninput="earn(${idx},'cap',this.value)"></div>
        <div><label>Wage Tier (₹)</label><input type="number" value="${c.wageTier??''}" placeholder="none" oninput="earn(${idx},'wageTier',this.value)"></div>
        <div><label>Cap Above Tier (₹)</label><input type="number" value="${c.capHigh??''}" placeholder="same cap" oninput="earn(${idx},'capHigh',this.value)"></div>
        <div><label>Min. Remuneration to Apply (₹)</label><input type="number" value="${c.minApplyWage??''}" placeholder="always applies" oninput="earn(${idx},'minApplyWage',this.value)"></div>
        <div><label>Threshold % (if gated)</label><input type="number" step="0.5" value="${c.thresholdPercent??''}" placeholder="same as Percent" oninput="earn(${idx},'thresholdPercent',this.value)"></div>
        <div class="chk"><input type="checkbox" id="gate_${idx}" ${c.gated?'checked':''} onchange="earn(${idx},'gated',this.checked)"><label for="gate_${idx}" style="margin:0;">Only pay if balance exceeds threshold</label></div>
      </div>` : ''}
      ${isFixed ? `<div class="comp-fields"><div><label>Fixed Amount (₹ / month)</label><input type="number" value="${c.fixedAmount}" oninput="earn(${idx},'fixedAmount',this.value)"></div></div>` : ''}
      ${isCappedRem ? `<div class="comp-fields"><div><label>Cap (₹)</label><input type="number" value="${c.cap??''}" oninput="earn(${idx},'cap',this.value)"></div></div><div class="comp-note">Pays out whatever balance is left, up to this cap.</div>` : ''}
      ${c.type==='remainder' ? `<div class="comp-note">Absorbs whatever balance is left after all components above. Usually kept last.</div>` : ''}
    </div>`;
  }).join('');
}
function earn(idx, field, value){
  const c = CONFIG.waterfall[idx];
  if(field==='name'){ c.name=value; return; }
  if(field==='category'){ c.category=value; runCalc(); return; }
  if(field==='type'){ c.type=value; renderEarnings(); runCalc(); return; }
  if(field==='base'){ c.base=value; }
  else if(field==='gated'){ c.gated=value; }
  else if(field==='fixedAmount'){ c.fixedAmount = parseFloat(value)||0; }
  else { c[field] = numOrNull(value); }
  runCalc();
}
function addEarning(){
  const hasRemainder = CONFIG.waterfall.some(e=>e.type==='remainder');
  const insertAt = CONFIG.waterfall.length - (hasRemainder?1:0);
  CONFIG.waterfall.splice(insertAt,0,
    {id:newId('comp'), name:'New Component', category:'earnings', type:'fixed', base:'wage', percent:0, nonMetroPercent:null, cap:null, capHigh:null, wageTier:null, minApplyWage:null, gated:false, thresholdPercent:null, fixedAmount:0});
  renderEarnings(); runCalc();
}
function removeEarning(idx){ CONFIG.waterfall.splice(idx,1); renderEarnings(); runCalc(); }
function moveEarning(idx, dir){
  const j = idx+dir;
  if(j<0 || j>=CONFIG.waterfall.length) return;
  [CONFIG.waterfall[idx], CONFIG.waterfall[j]] = [CONFIG.waterfall[j], CONFIG.waterfall[idx]];
  renderEarnings(); runCalc();
}

function renderBenefits(){
  const el = document.getElementById('benefitsList');
  el.innerHTML = CONFIG.benefits.map((b,idx)=>`
    <div class="comp-card">
      <div class="comp-head">
        <input type="text" value="${escapeHtml(b.name)}" oninput="benefit(${idx},'name',this.value)">
        <div class="comp-fields" style="grid-template-columns:180px;margin-top:0;">
          <div><label>Amount (₹ / month)</label><input type="number" value="${b.amount}" oninput="benefit(${idx},'amount',this.value)"></div>
        </div>
        <div class="comp-actions"><button class="btn danger small" onclick="removeBenefit(${idx})">Delete</button></div>
      </div>
    </div>`).join('');
}
function benefit(idx, field, value){
  const b = CONFIG.benefits[idx];
  if(field==='name') b.name=value; else b.amount = parseFloat(value)||0;
  runCalc();
}
function addBenefit(){ CONFIG.benefits.push({id:newId('ben'), name:'New Benefit', amount:0}); renderBenefits(); runCalc(); }
function removeBenefit(idx){ CONFIG.benefits.splice(idx,1); renderBenefits(); runCalc(); }


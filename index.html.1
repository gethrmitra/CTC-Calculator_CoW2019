/* ============================================================
   CALCULATION ENGINE
   ============================================================ */
function fmt(n){ if(n===null||n===undefined||isNaN(n)) return "–"; return "₹"+Math.round(n).toLocaleString('en-IN'); }
function r0(n){ return Math.round(n); }

function computeWaterfall(R, basic, metro, startingRemaining){
  let remaining = startingRemaining;
  const lines = [];
  CONFIG.waterfall.forEach(comp=>{
    let amt = 0;
    if(comp.type==='fixed'){
      amt = comp.fixedAmount||0;
    } else if(comp.type==='remainder'){
      amt = Math.max(0, remaining);
    } else if(comp.type==='remainderCapped'){
      const cap = (comp.cap===null||comp.cap===undefined) ? Infinity : comp.cap;
      amt = Math.max(0, Math.min(remaining, cap));
    } else if(comp.type==='percent'){
      const baseVal = comp.base==='basic' ? basic : R;
      let pct = comp.percent;
      if(metro==='N' && comp.nonMetroPercent!==null && comp.nonMetroPercent!==undefined && comp.nonMetroPercent!=='') pct = comp.nonMetroPercent;
      let cap = comp.cap;
      if(comp.wageTier && R>=comp.wageTier && comp.capHigh!==null && comp.capHigh!==undefined && comp.capHigh!=='') cap = comp.capHigh;
      let alloc = baseVal*pct/100;
      if(cap!==null && cap!==undefined && cap!=='') alloc = Math.min(alloc, cap);
      if(comp.minApplyWage && R < comp.minApplyWage){
        amt = 0;
      } else if(comp.gated){
        const thPct = (comp.thresholdPercent!==null && comp.thresholdPercent!==undefined && comp.thresholdPercent!=='') ? comp.thresholdPercent : pct;
        const gateVal = R*thPct/100;
        amt = (remaining > gateVal) ? Math.max(0, Math.min(alloc, remaining)) : 0;
      } else {
        amt = Math.max(0, Math.min(alloc, remaining));
      }
    }
    amt = r0(amt);
    remaining -= amt;
    lines.push({id:comp.id, name:comp.name, category:comp.category, amount:amt});
  });
  return {lines, unallocated: Math.max(0, r0(remaining))};
}

function calculate(inputs){
  const {state, category, pf, metro, pfBasis, empType, wage, hikePct, incentivePct} = inputs;
  const MW = getMW(state, category);
  const warnings = [];
  const R = r0(wage * (1 + hikePct/100));

  if(MW===null) warnings.push("No published minimum wage data for this state/category — Basic will be based purely on "+CONFIG.basicPercent+"% of Remuneration.");

  if(empType === 'CONSULTANT'){
    const totalBenefits = CONFIG.benefits.reduce((s,b)=>s+(b.amount||0),0);
    const incentive = r0(R*incentivePct/100);
    warnings.push("Consultant/Retainer mode: no PF, Bonus, ESI or Gratuity is applied — the full amount is paid as a retainer fee. This is a simplified path added by this tool.");
    return {
      MW, R, basic:0, employerPF:0, bonus:0, waterfall:{lines:[],unallocated:0},
      employerESI:0, gratuity:0, benefits:CONFIG.benefits.map(b=>({name:b.name,amount:0})), totalBenefits:0,
      ctc:R+incentive, incentive, employeePF:0, employeeESI:0, cih:R,
      warnings, retainer:true
    };
  }

  const half = R*CONFIG.basicPercent/100;
  const mwVal = MW===null ? 0 : MW;
  const basic = r0(Math.max(half, mwVal));
  if(MW!==null && R < MW){
    warnings.push(`Offered Remuneration (₹${R.toLocaleString('en-IN')}) is below the applicable minimum wage (₹${MW.toLocaleString('en-IN')}). Basic has been raised to the Minimum Wage, which may leave little or nothing for other components.`);
  }

  const pfWageBase = (pfBasis==='15K') ? Math.min(basic, CONFIG.pfCeiling) : basic;
  const employerPF = (pf==='Y') ? r0(pfWageBase*CONFIG.employerPFPercent/100) : 0;
  const employeePF = (pf==='Y') ? r0(pfWageBase*CONFIG.employeePFPercent/100) : 0;

  const bonus = (basic <= CONFIG.bonusThreshold) ? r0(basic*CONFIG.bonusPercent/100) : 0;

  const remainingAfterCore = R - basic - employerPF - bonus;
  if(remainingAfterCore < 0){
    warnings.push("Remuneration is too low to cover Basic, Employer PF and Statutory Bonus together — all other components have been floored at zero. Increase the offered wage.");
  }

  const waterfall = computeWaterfall(R, basic, metro, remainingAfterCore);
  if(waterfall.unallocated > 0){
    warnings.push(`₹${waterfall.unallocated.toLocaleString('en-IN')} of Remuneration is not absorbed by any component — check that Residual Allowance (or another "Full Remainder" component) is present and last in the list.`);
  }

  const waterfallTotal = waterfall.lines.reduce((s,l)=>s+l.amount,0);
  const RCheck = basic + employerPF + bonus + waterfallTotal; // should equal R

  const employerESI = (basic <= CONFIG.employerEsicThreshold) ? r0(basic*CONFIG.employerEsicPercent/100) : 0;
  const gratuity = r0(basic*CONFIG.gratuityPercent/100);
  const employeeESI = (basic < CONFIG.employeeEsicThreshold) ? r0(basic*CONFIG.employeeEsicPercent/100) : 0;

  const benefits = CONFIG.benefits.map(b=>({name:b.name, amount:b.amount||0}));
  const totalBenefits = benefits.reduce((s,b)=>s+b.amount,0);

  const ctc = RCheck + employerESI + gratuity + totalBenefits;
  const cih = RCheck - employerPF - employeePF - employeeESI;

  const incentiveBaseVal = CONFIG.incentiveBase==='basic' ? basic : (CONFIG.incentiveBase==='ctc' ? ctc : RCheck);
  const incentive = r0(incentiveBaseVal*incentivePct/100);

  return {MW, R:RCheck, basic, employerPF, bonus, waterfall, employerESI, gratuity, benefits, totalBenefits, ctc, incentive, employeePF, employeeESI, cih, warnings, retainer:false};
}

